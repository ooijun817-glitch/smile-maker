# このファイルを .env という名前でコピーして、鍵を書き込んでください。
# .env は .gitignore に入っているので、GitHub には保存されません。

# Kling 開発者画面で発行した鍵(2つで1組)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# 以下は必要なときだけ変える
# 窓口の住所(国際版)。古い住所は https://api.klingai.com
KLING_API_BASE=https://api-singapore.klingai.com
# 使うモデル。最後の絵(image_tail)を使うので、対応しているモデルと高画質(pro)にする
KLING_MODEL=kling-v2-5-turbo
KLING_MODE=pro
